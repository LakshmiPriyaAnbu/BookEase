    <!-- ── How It Works ────────────────────────────────────────────────────── -->
    <string name="how_it_works_eyebrow">HOW IT WORKS</string>
    <string name="how_it_works_title">Booked in three steps</string>
    <string name="how_it_works_subtitle">From browsing to booking, we\'ve made it effortless. No phone calls, no waiting — just tap and you\'re on the schedule.</string>
    <string name="how_it_works_step1_title">Choose a service</string>
    <string name="how_it_works_step1_desc">Browse our curated catalog of fitness, wellness, and nutrition sessions. Filter by category, coach, or price to find the perfect match for your goals.</string>
    <string name="how_it_works_step2_title">Pick a time slot</string>
    <string name="how_it_works_step2_desc">Select a date and time that works for you from real-time availability. Your slot is held for 10 minutes while you complete the booking.</string>
    <string name="how_it_works_step3_title">Confirm &amp; go</string>
    <string name="how_it_works_step3_desc">Review your booking summary, pay securely in-app, and receive an instant confirmation. Calendar sync and reminders handle the rest.</string>
